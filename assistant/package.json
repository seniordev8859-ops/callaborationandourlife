{
  "name": "interview-assistant",
  "version": "0.1.0",
  "description": "Real-time interview helper for non-native English speakers (React web app + local server)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,green \"node --watch-path=server server/index.cjs\" \"vite\"",
    "companion": "concurrently -k -n build,server -c yellow,blue \"vite build --watch\" \"node --watch-path=server server/index.cjs\"",
    "build": "vite build",
    "start": "vite build && node server/index.cjs --open",
    "serve": "node server/index.cjs --open",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && node --test"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Interview Assistant"
}
